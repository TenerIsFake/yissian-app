{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "/home/tener/.secrets/play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      },
      "ios": {
        "bundleIdentifier": "com.tenerisfake.yissian",
        "language": "en-US"
      }
    }
  }
}
